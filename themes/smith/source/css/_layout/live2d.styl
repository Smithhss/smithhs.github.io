#live2d-container
  position: fixed
  bottom: 0
  right: 20px
  width: 350px
  height: 350px
  z-index: 100
  pointer-events: none

  #live2d-canvas
    width: 100%
    height: 100%
    pointer-events: auto
    cursor: pointer

  .live2d-toggle
    position: absolute
    top: -30px
    right: 10px
    width: 30px
    height: 30px
    border-radius: 50%
    background: var(--smith-main)
    color: #fff
    border: none
    cursor: pointer
    font-size: 14px
    display: flex
    align-items: center
    justify-content: center
    pointer-events: auto

@media screen and (max-width: 768px)
  #live2d-container
    width: 150px
    height: 150px
    right: 10px
